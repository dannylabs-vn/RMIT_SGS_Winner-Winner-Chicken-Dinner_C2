{
  "name": "kinkey",
  "version": "0.1.0",
  "private": true,
  "description": "KinKey: a family safe with no key-holder. Built on TideCloak.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "check:plaintext": "node --no-warnings scripts/check-no-plaintext.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tidecloak/nextjs": "0.14.40",
    "@tidecloak/verify": "0.14.33",
    "jose": "5.10.0",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "postcss": "8.5.25"
  }
}
